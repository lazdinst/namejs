# CARTO basemap API key — https://carto.com/basemaps/apikey
# Copy this file to client/.env and paste your key in. Without it the map
# silently falls back to Esri's keyless dark canvas (see src/app/Map/basemap.ts).
VITE_CARTO_API_KEY=

# Backend host/port. Defaults to localhost:4000 when unset.
# VITE_SERVER_HOST=localhost
# VITE_SERVER_PORT=4000
